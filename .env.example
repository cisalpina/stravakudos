# ── Required ──────────────────────────────────────────────────────────────────

STRAVA_EMAIL=you@example.com
STRAVA_PASSWORD=your_strava_password

# Gmail with an App Password (not your regular Gmail password).
# Create one at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where to send failure alert emails
NOTIFY_EMAIL=you@example.com

# ── Optional tuning (shown with defaults) ─────────────────────────────────────

# Maximum kudos to give per run
MAX_KUDOS=20

# Stop giving kudos to activities older than this many hours
LOOKBACK_HOURS=24

# Minutes between runs; set to 0 to run once and exit
RUN_INTERVAL_MINUTES=10

# Directory for cookies, last_run.json, error screenshots
DATA_DIR=./data

# Set to true to run the browser headlessly (no visible window / noVNC)
HEADLESS=false

# URL included in the "session expired" notification email — set to your host's address
# so the link is clickable (e.g. http://192.168.1.50:6080 for an Unraid server)
NOVNC_URL=http://localhost:6080
